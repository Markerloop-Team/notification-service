# Notification Service Configuration
PORT=8083
HOST=0.0.0.0

# Server Timeouts
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s

# Email Configuration

# Для локальной разработки используйте MailHog (TLS отключен):
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_DISABLE_TLS=true
# FROM_EMAIL=noreply@markerloop.com
# MAIL_TIMEOUT=30s

# Для production используйте Google Workspace SMTP Relay (рекомендуется):
MAIL_HOST=smtp-relay.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_DISABLE_TLS=false
FROM_EMAIL=noreply@yourdomain.com
# FROM_EMAIL может быть любым email вашего домена (noreply@, support@, info@ и т.д.)
# MAIL_TIMEOUT: Timeout для SMTP соединения (по умолчанию 30s)
# Рекомендуется установить 60s или больше для первого подключения после разблокировки порта
MAIL_TIMEOUT=60s

# Альтернатива: SMTP с паролем приложения (если SMTP Relay не подходит):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=noreply@yourdomain.com
# MAIL_PASSWORD=your-google-workspace-app-password-here
# FROM_EMAIL=noreply@yourdomain.com

# Инструкции по настройке:
# - SMTP Relay: dev-infra/SMTP_RELAY_SETUP.md (рекомендуется)
# - SMTP с паролем: dev-infra/GOOGLE_WORKSPACE_SMTP_SETUP.md

# Email Templates Configuration
EMAIL_VERIFICATION_SUBJECT=Подтверждение email адреса
EMAIL_VERIFICATION_VALIDITY=15 минут
EMAIL_WELCOME_SUBJECT=Добро пожаловать в MarkerLoop!
EMAIL_PASSWORD_RESET_SUBJECT=Сброс пароля
EMAIL_PASSWORD_RESET_VALIDITY=1 час
EMAIL_COMPANY_NAME=Команда MarkerLoop

# Logging
LOG_LEVEL=info